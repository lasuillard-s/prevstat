{
	"name": "prevstat",
	"private": true,
	"readme": "README.md",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lasuillard-s/prevstat.git"
	},
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"homepage": "https://github.com/lasuillard-s/prevstat",
	"bugs": {
		"url": "https://github.com/lasuillard-s/prevstat/issues"
	},
	"scripts": {
		"dev": "tsc; node ./dist/src/main.js",
		"dev:watch": "nodemon",
		"build": "node build.js",
		"fmt": "prettier --write --list-different .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest --silent --watch"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-ssm": "3.1105.0",
		"@aws-sdk/cloudfront-signer": "3.1095.0",
		"@codegenie/serverless-express": "5.0.0",
		"@octokit/auth-oauth-user": "6.0.2",
		"adm-zip": "0.6.0",
		"express": "5.2.1",
		"jsonwebtoken": "9.0.3",
		"minimatch": "10.2.5",
		"probot": "14.3.2",
		"zod": "4.4.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.6",
		"@eslint/js": "10.0.1",
		"@types/adm-zip": "0.5.8",
		"@types/aws-cloudfront-function": "1.0.8",
		"@types/express": "5.0.6",
		"@types/jsonwebtoken": "9.0.10",
		"@types/node": "24.13.3",
		"@vitest/coverage-v8": "4.1.10",
		"esbuild": "0.28.1",
		"esbuild-plugin-clean": "1.0.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "63.1.0",
		"globals": "17.7.0",
		"ioredis": "5.11.1",
		"nock": "14.0.16",
		"nodemon": "3.1.14",
		"prettier": "3.9.5",
		"smee-client": "5.0.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.64.0",
		"vitest": "4.1.10"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
