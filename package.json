{
	"name": "presta",
	"version": "0.1.0",
	"private": true,
	"description": "A GitHub App to automate validating your repository dev container configuration.",
	"keywords": [
		"github-app",
		"wrangler"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lasuillard-s/presta.git"
	},
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"homepage": "https://github.com/lasuillard-s/presta",
	"bugs": {
		"url": "https://github.com/lasuillard-s/presta/issues"
	},
	"scripts": {
		"dev": "wrangler dev",
		"build": "node build.js",
		"fmt": "prettier --write --list-different .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:watch": "vitest --silent --watch"
	},
	"type": "module",
	"dependencies": {
		"@octokit/app": "16.1.2",
		"zod": "4.4.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "10.0.1",
		"@octokit/app": "16.1.2",
		"@types/node": "24.13.2",
		"@vitest/coverage-v8": "4.1.9",
		"esbuild": "0.28.1",
		"esbuild-plugin-clean": "1.0.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "63.0.10",
		"globals": "17.7.0",
		"nock": "14.0.16",
		"prettier": "3.9.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.0",
		"vitest": "4.1.9",
		"wrangler": "4.113.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"workerd@1.20260721.1": true
	}
}
