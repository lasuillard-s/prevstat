{
	"name": "prevstat",
	"private": true,
	"readme": "README.md",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lasuillard-s/prevstat.git"
	},
	"author": {
		"name": "Yuchan Lee",
		"url": "https://github.com/lasuillard",
		"email": "lasuillard@gmail.com"
	},
	"homepage": "https://github.com/lasuillard-s/prevstat",
	"bugs": {
		"url": "https://github.com/lasuillard-s/prevstat/issues"
	},
	"scripts": {
		"dev": "tsc; node ./dist/src/main.js",
		"dev:watch": "nodemon",
		"build": "node build.js",
		"fmt": "prettier --write --list-different .",
		"fmt:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"test:unit": "vitest --run --exclude '**/*.integration.test.ts'",
		"test:integration": "vitest --run integration",
		"test:watch": "vitest --watch"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "3.1146.0",
		"@aws-sdk/client-sqs": "3.1146.0",
		"@aws-sdk/cloudfront-signer": "3.1138.0",
		"@aws-sdk/lib-storage": "3.1146.0",
		"@codegenie/serverless-express": "5.0.0",
		"@octokit/auth-oauth-user": "6.0.4",
		"express": "5.2.1",
		"jsonwebtoken": "9.0.3",
		"mime-types": "3.0.2",
		"minimatch": "10.2.6",
		"probot": "14.3.2",
		"unzipper": "0.12.5",
		"zod": "4.6.5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "error"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=11",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"@eslint/eslintrc": "3.3.7",
		"@eslint/js": "10.0.1",
		"@testcontainers/localstack": "12.2.0",
		"@types/adm-zip": "0.5.8",
		"@types/aws-cloudfront-function": "1.0.8",
		"@types/express": "5.0.6",
		"@types/jsonwebtoken": "9.0.10",
		"@types/mime-types": "3.0.1",
		"@types/node": "24.19.1",
		"@types/unzipper": "0.10.11",
		"@vitest/coverage-v8": "5.0.3",
		"@vitest/ui": "5.0.3",
		"adm-zip": "0.6.1",
		"esbuild": "0.28.2",
		"esbuild-plugin-clean": "1.0.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-jsdoc": "65.1.0",
		"globals": "17.13.0",
		"ioredis": "6.0.0",
		"nock": "14.0.17",
		"nodemon": "3.1.14",
		"prettier": "3.9.9",
		"smee-client": "5.0.0",
		"testcontainers": "12.2.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.3"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
