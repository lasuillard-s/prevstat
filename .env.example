# Probot
# -----------------------------------------------------------------------------
# https://probot.github.io/docs/configuration/

# If `--host` option of `probot run` does not work, you can use `HOST` instead:
# HOST=0.0.0.0

# * Probot will not process events until the required environment variables are set.
# Use "trace" to get verbose logging or `info` to show less
LOG_LEVEL=debug

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

# Your GitHub App details
APP_ID=
PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEBHOOK_SECRET=

# Application configuration
# -----------------------------------------------------------------------------

# Access control (comma-separated list of users/organizations allowed to install the app)
# Defaults to `*` (installations allowed for all principals). If explicitly empty, all installations are rejected.
# ALLOWED_PRINCIPALS=*

# CloudFront configuration
# CLOUDFRONT_DOMAIN=
# CLOUDFRONT_PRIVATE_KEY=
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_SIGNED_COOKIE_EXPIRATION_SECONDS=

# Origin verification secret (CloudFront - Lambda)
# ORIGIN_VERIFY_SECRET=

# Artifacts storage
# S3_BUCKET_NAME=

# Tasks queue
# SQS_QUEUE_URL=

# Additional security for GitHub OAuth flow
# JWT_SECRET=
# JWT_EXPIRATION_SECONDS=

# Artifact matching
# ARTIFACT_PATTERNS=
