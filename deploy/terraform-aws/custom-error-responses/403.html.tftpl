<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Authentication Required | Prevstat</title>
		<style>
			:root {
				--bg: #0d1117;
				--card-bg: #161b22;
				--border: #30363d;
				--text-primary: #e6edf3;
				--text-secondary: #8b949e;
				--accent: #238636;
				--accent-hover: #2ea043;
				--link: #58a6ff;
				--code-bg: #0d1117;
				--font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
				--font-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
			}

			@media (prefers-color-scheme: light) {
				:root {
					--bg: #f6f8fa;
					--card-bg: #ffffff;
					--border: #d0d7de;
					--text-primary: #1f2328;
					--text-secondary: #656d76;
					--accent: #1f883d;
					--accent-hover: #1a7f37;
					--link: #0969da;
					--code-bg: #f6f8fa;
				}
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				background-color: var(--bg);
				color: var(--text-primary);
				font-family: var(--font-sans);
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				padding: 1.5rem;
			}

			.card {
				background-color: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 8px;
				max-width: 560px;
				width: 100%;
				padding: 2rem;
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
			}

			.header {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.lock-icon {
				width: 28px;
				height: 28px;
				fill: currentColor;
				color: #e3b341;
				flex-shrink: 0;
			}

			h1 {
				font-size: 1.35rem;
				font-weight: 600;
				line-height: 1.3;
			}

			.description {
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.5;
				margin-bottom: 1.5rem;
			}

			.context-box {
				background-color: var(--code-bg);
				border: 1px solid var(--border);
				border-radius: 6px;
				padding: 1rem;
				margin-bottom: 1.5rem;
				font-size: 0.875rem;
			}

			.context-row {
				display: flex;
				margin-bottom: 0.6rem;
			}

			.context-row:last-child {
				margin-bottom: 0;
			}

			.context-label {
				width: 130px;
				color: var(--text-secondary);
				flex-shrink: 0;
			}

			.context-value {
				color: var(--text-primary);
				font-family: var(--font-mono);
				word-break: break-all;
			}

			.context-link {
				color: var(--link);
				text-decoration: none;
			}

			.context-link:hover {
				text-decoration: underline;
			}

			.context-unknown {
				color: var(--text-secondary);
				font-style: italic;
			}

			.btn-auth {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.6rem;
				width: 100%;
				padding: 0.75rem 1rem;
				background-color: var(--accent);
				color: #ffffff;
				border: none;
				border-radius: 6px;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
				text-decoration: none;
				transition: background-color 0.2s ease;
			}

			.btn-auth:hover:not(:disabled) {
				background-color: var(--accent-hover);
			}

			.btn-auth:disabled {
				opacity: 0.65;
				cursor: not-allowed;
			}

			.github-icon {
				width: 20px;
				height: 20px;
				fill: currentColor;
			}

			.footer {
				margin-top: 1.25rem;
				text-align: center;
				font-size: 0.8rem;
				color: var(--text-secondary);
			}
		</style>
		<script>
			// The error page is served from S3, so we need to use the CloudFront domain
			// to redirect to the Lambda function for authentication.
			const cloudfrontDomain = '${CLOUDFRONT_DOMAIN}';

			// URL representing the current request; edit this value to test different URLs for debugging
			const currentUrl = new URL(window.location.href);

			// Redirect user to authentication page then back to the current page after authentication
			const redirectUri = new URL('/api/auth', 'https://' + cloudfrontDomain);
			redirectUri.searchParams.set('redirect_uri', currentUrl.href);

			function authenticate() {
				const btn = document.getElementById('btn-auth');
				const btnText = document.getElementById('btn-auth-text');
				if (btn) {
					btn.disabled = true;
				}
				if (btnText) {
					btnText.textContent = 'Redirecting to GitHub...';
				}
				window.location.replace(redirectUri);
			}

			function setElementContent(el, text, isUnknown, href) {
				el.textContent = '';
				if (isUnknown) {
					const span = document.createElement('span');
					span.className = 'context-unknown';
					span.textContent = text;
					el.appendChild(span);
				} else if (href) {
					const a = document.createElement('a');
					a.className = 'context-link';
					a.href = href;
					a.target = '_blank';
					a.rel = 'noopener noreferrer';
					a.textContent = text;
					el.appendChild(a);
				} else {
					el.textContent = text;
				}
			}

			document.addEventListener('DOMContentLoaded', () => {
				// Path pattern: /<visibility>/<owner>/<repo>/<workflowRunId>/<artifactName>/<filePath...>
				// Normalize pathname: strip query params/hash (if any) and trim leading/trailing slashes
				const path = currentUrl.pathname.replace(/^\/+|\/+$/g, '');
				const parts = path ? path.split('/') : [];
				const [visibility, owner, repo, workflowRunId, artifactName, ...filePathParts] = parts;
				const filePath = filePathParts.length > 0 ? filePathParts.join('/') : undefined;

				const decodedOwner = owner ? decodeURIComponent(owner) : undefined;
				const decodedRepo = repo ? decodeURIComponent(repo) : undefined;
				const decodedRunId = workflowRunId ? decodeURIComponent(workflowRunId) : undefined;
				const decodedArtifact = artifactName ? decodeURIComponent(artifactName) : undefined;
				const decodedFile = filePath ? decodeURIComponent(filePath) : undefined;

				const repoEl = document.getElementById('val-repo');
				if (decodedOwner && decodedRepo) {
					const repoName = decodedOwner + '/' + decodedRepo;
					document.title = 'Authentication Required \u2022 ' + repoName + ' | Prevstat';
					setElementContent(repoEl, repoName, false, 'https://github.com/' + repoName);
				} else if (decodedOwner) {
					document.title = 'Authentication Required \u2022 ' + decodedOwner + ' | Prevstat';
					setElementContent(repoEl, decodedOwner, false, 'https://github.com/' + decodedOwner);
				} else {
					setElementContent(repoEl, '(unknown)', true);
				}

				const runEl = document.getElementById('val-run-id');
				if (decodedRunId) {
					const runHref =
						decodedOwner && decodedRepo
							? 'https://github.com/' +
								decodedOwner +
								'/' +
								decodedRepo +
								'/actions/runs/' +
								decodedRunId
							: undefined;
					setElementContent(runEl, decodedRunId, false, runHref);
				} else {
					setElementContent(runEl, '(unknown)', true);
				}

				const artifactEl = document.getElementById('val-artifact');
				setElementContent(artifactEl, decodedArtifact || '(unknown)', !decodedArtifact);

				const fileEl = document.getElementById('val-file');
				setElementContent(fileEl, decodedFile || '(unknown)', !decodedFile);
			});
		</script>
	</head>
	<body>
		<main class="card">
			<div class="header">
				<svg class="lock-icon" viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
					/>
				</svg>
				<h1>Authentication Required</h1>
			</div>

			<p class="description">
				This artifact is private. Please sign in with GitHub to verify read access to the
				repository.
			</p>

			<div class="context-box">
				<div class="context-row">
					<span class="context-label">Repository:</span>
					<span id="val-repo" class="context-value"></span>
				</div>
				<div class="context-row">
					<span class="context-label">Run ID:</span>
					<span id="val-run-id" class="context-value"></span>
				</div>
				<div class="context-row">
					<span class="context-label">Artifact Name:</span>
					<span id="val-artifact" class="context-value"></span>
				</div>
				<div class="context-row">
					<span class="context-label">File Path:</span>
					<span id="val-file" class="context-value"></span>
				</div>
			</div>

			<button id="btn-auth" class="btn-auth" onclick="authenticate()">
				<svg class="github-icon" viewBox="0 0 16 16" aria-hidden="true">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					/>
				</svg>
				<span id="btn-auth-text">Authenticate with GitHub</span>
			</button>

			<div class="footer">Prevstat</div>
		</main>
	</body>
</html>
