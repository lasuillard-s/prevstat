{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>lasuillard-s/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Group non-major Terraform provider updates monthly",
      "matchManagers": [
        "terraform"
      ],
      "matchDatasources": [
        "terraform-provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Terraform Providers (non-major)",
      "groupSlug": "terraform-providers",
      "schedule": [
        "* 9-17 1 * *"
      ]
    }
  ]
}
